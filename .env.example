# BTC Radar MCP Configuration Example
# Copy this file to .env and adjust variables as needed

# Optional: Override custom config directory path (default: ./config)
# BTC_RADAR_CONFIG_DIR=./config

# Optional: Bitcoin-Data API key for higher rate limits (default: unauthenticated)
# BTC_RADAR_BITCOIN_DATA_API_KEY=your_api_key_here

# Optional: SQLite Database Path for PIT store (default: in-memory / default store)
# BTC_RADAR_DB_PATH=./btc_radar.db

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
