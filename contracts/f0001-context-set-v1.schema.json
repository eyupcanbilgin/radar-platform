{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar-platform.local/contracts/f0001-context-set-v1.schema.json",
  "title": "F-0001 Context Set Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "variant",
    "excluded_features",
    "start_utc",
    "end_exclusive_utc",
    "locked_oos_start_utc",
    "rules_version",
    "rules_sha256",
    "context_count",
    "unavailable_count",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "f0001-context-set/v1" },
    "hypothesis_id": { "const": "F-0001" },
    "variant": {
      "enum": ["combined", "without_funding_stress", "without_oi_buildup"]
    },
    "excluded_features": {
      "type": "array",
      "items": { "enum": ["funding_stress", "oi_buildup"] },
      "uniqueItems": true
    },
    "start_utc": { "type": "string", "format": "date-time" },
    "end_exclusive_utc": { "type": "string", "format": "date-time" },
    "locked_oos_start_utc": { "type": "string", "format": "date-time" },
    "rules_version": { "type": "string", "minLength": 1 },
    "rules_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "context_count": { "type": "integer", "minimum": 1 },
    "unavailable_count": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
