# Bu dosyayı `.env` olarak kopyalayıp KENDİ değerlerini yaz. `.env` git dışıdır.
# Kurulum adımları: docs/TELEGRAM-KURULUM.md
# Zorunlu: üretimde telegram; yalnız bilinçli yerel geliştirmede console.
RADAR_SIGNAL_DELIVERY_MODE=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook HMAC için yalnız taşıma sırrı; borsa/private API anahtarı değildir.
RADAR_SIGNAL_WEBHOOK_SECRET=

# Opsiyonel: defter/outbox veritabanlarının dizini (varsayılan: ./var)
# RADAR_SIGNAL_DB_DIR=

# Opsiyonel: decision-context/v1 exact-hour JSON inbox kökü
# RADAR_SIGNAL_CONTEXT_DIR=
