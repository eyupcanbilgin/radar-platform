# BTC Radar MCP Configuration Example
# Copy this file to .env and adjust variables as needed

# Optional: Override custom config directory path (default: ./config)
# BTC_RADAR_CONFIG_DIR=./config

# Optional: Bitcoin-Data API key for higher rate limits (default: unauthenticated)
# BTC_RADAR_BITCOIN_DATA_API_KEY=your_api_key_here

# Optional: Producer PIT database path (CLI default: ./var/pit.sqlite)
# Core PointInTimeStore(path=None) remains in-memory for tests.
# BTC_RADAR_DB_PATH=./btc_radar.db

# Optional: Immutable snapshot database path (producer publish command)
# BTC_RADAR_SNAPSHOT_DB_PATH=./var/snapshots.sqlite

# Required for producer publish: radar-signal exact-hour inbox root
# BTC_RADAR_CONTEXT_ROOT=../radar-signal/var/decision-context

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
